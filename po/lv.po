#: fuse/guestunmount.c:61
#, c-format
msgid ""
"%s: clean up a mounted filesystem\n"
"Copyright (C) 2013 Red Hat Inc.\n"
"Usage:\n"
"  %s [--fd=FD] mountpoint\n"
"Options:\n"
"  --fd=FD              Pipe file descriptor to monitor\n"
"  --help               Display help message and exit\n"
"  -q|--quiet           Don't print fusermount errors\n"
"  --no-retry           Don't retry fusermount\n"
"  --retry=N            Retry fusermount N times (default: 5)\n"
"  -v|--verbose         Verbose messages\n"
"  -V|--version         Display version and exit\n"
msgstr ""
"%s: sakopt montētu failu sistēmu\n"
"Autortiesības (C) 2013 Red Hat Inc.\n"
"Lietošana:\n"
"  %s [--fd=FD] montēšanas_punkts\n"
"Opcijas:\n"
"  --fd=FD              Uzraudzāmais konveijera faila deskriptors\n"
"  --help               Parādīt palīdzības ziņojumu un iziet\n"
"  -q|--quiet           Neizvadīt fusermount kļūdas\n"
"  --no-retry           Neatkārtot fusermount\n"
"  --retry=N            Atkārtot fusermount N reizes (noklusējums: 5)\n"
"  -v|--verbose         Detalizēti ziņojumi\n"
"  -V|--version         Parādīt versiju un iziet\n"

