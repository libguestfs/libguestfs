"                       const char **firmware, char **code, char **vars,\n"
"                       int *flags)\n"
"\n"
msgstr ""
" int\n"
" guestfs_int_get_uefi (guestfs_h *g, char *const *firmwares,\n"
"                       const char **firmware, char **code, char **vars,\n"
"                       int *flags)\n"
