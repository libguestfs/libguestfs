#~ msgid "Save the following script as F<time.stap>:"
#~ msgstr "Збережіть такий скрипт із назвою F<time.stap>:"

#, no-wrap
#~ msgid ""
#~ " global last;\n"
#~ " \n"
#~ msgstr ""
#~ " global last;\n"
#~ " \n"

#, no-wrap
#~ msgid ""
#~ " function display_time () {\n"
#~ "       now = gettimeofday_us ();\n"
#~ "       delta = 0;\n"
#~ "       if (last > 0)\n"
#~ "             delta = now - last;\n"
#~ "       last = now;\n"
#~ " \n"
#~ msgstr ""
#~ " function display_time () {\n"
#~ "       now = gettimeofday_us ();\n"
#~ "       delta = 0;\n"
#~ "       if (last > 0)\n"
#~ "             delta = now - last;\n"
#~ "       last = now;\n"
#~ " \n"

#, no-wrap
#~ msgid ""
#~ "       printf (\"%d (+%d):\", now, delta);\n"
#~ " }\n"
#~ " \n"
#~ msgstr ""
#~ "       printf (\"%d (+%d):\", now, delta);\n"
#~ " }\n"
#~ " \n"

#, no-wrap
#~ msgid ""
#~ " probe begin {\n"
#~ "       last = 0;\n"
#~ "       printf (\"ready\\n\");\n"
#~ " }\n"
