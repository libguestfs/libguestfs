#~ "virt-alignment-scan — перевірка вирівнювання розділів віртуальної машини"

#, no-wrap
#~ msgid ""
#~ " virt-alignment-scan [--options] -d domname\n"
#~ "\n"
#~ msgstr ""
#~ " virt-alignment-scan [--параметри] -d назва_домену\n"
