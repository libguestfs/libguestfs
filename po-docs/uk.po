#~ msgid "C<format=raw>"
#~ msgstr "C<format=raw>"

#~ msgid "C<format=qcow2>"
#~ msgstr "C<format=qcow2>"

#~ msgid ""
#~ "Specify the format of the disk image; in case it is compressed, that is "
#~ "the format before the compression.  If not given, the format is "
