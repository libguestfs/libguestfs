#~ msgid ""
#~ " $ virt-v2v \\\n"
#~ "     -i vmx -it ssh \\\n"
#~ "     \"ssh://root@esxi.example.com/vmfs/volumes/datastore1/guest/"
#~ "guest.vmx\" \\\n"
#~ "     -o local -os /var/tmp\n"
#~ "\n"
#~ msgstr ""
#~ " $ virt-v2v \\\n"
#~ "     -i vmx -it ssh \\\n"
#~ "     \"ssh://root@esxi.example.com/vmfs/volumes/datastore1/guest/"
#~ "guest.vmx\" \\\n"
#~ "     -o local -os /var/tmp\n"
#~ "\n"

