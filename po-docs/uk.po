#~ " virt-builder fedora-27 --firstboot /tmp/dnf-update.sh\n"
#~ "\n"

#~ msgid "or simply:"
#~ msgstr "або просто:"

#, no-wrap
#~ msgid ""
#~ " virt-builder fedora-27 --firstboot-command 'dnf -y --best update'\n"
