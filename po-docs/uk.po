#~ " $ virt-v2v --print-estimate --machine-readable=file:estimates\n"
#~ " ...\n"
#~ " $ cat estimates\n"
#~ " {\n"
#~ "  \"disks\": [ 100000, 200000 ],\n"
#~ "  \"total\": 300000\n"
#~ " }\n"
#~ "\n"
#~ msgstr ""
#~ " $ virt-v2v --print-estimate --machine-readable=file:estimates\n"
#~ " ...\n"
#~ " $ cat estimates\n"
#~ " {\n"
#~ "  \"disks\": [ 100000, 200000 ],\n"
#~ "  \"total\": 300000\n"
#~ " }\n"
#~ "\n"

#~ msgid ""
