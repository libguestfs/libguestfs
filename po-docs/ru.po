msgstr "libguestfs-test-tool приостанавливается при использовании опции --help"

#. type: =item
#: docs/guestfs-release-notes-1.20.pod:453
msgid "L<https://bugzilla.redhat.com/876579>"
msgstr "L<https://bugzilla.redhat.com/876579>"

#. type: textblock
