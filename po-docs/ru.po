" void\n"
" guestfs_int_cmd_add_arg (struct command *cmd, const char *arg)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_add_arg (struct command *cmd, const char *arg)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:371
msgid "Add single arg (for C<execv>-style command execution)."
msgstr "Добавить один аргумент (для выполнения команды в стиле C<execv>)."

#. type: =head4
#: docs/internal-documentation.pod:373
msgid "Function C<lib/command.c:guestfs_int_cmd_add_arg_format>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_add_arg_format>"

#. type: verbatim
#: docs/internal-documentation.pod:375
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_add_arg_format (struct command *cmd, const char *fs, ...)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_add_arg_format (struct command *cmd, const char *fs, ...)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:378
msgid ""
"Add single arg (for C<execv>-style command execution)  using a L<printf(3)>-"
"style format string."
msgstr ""
"Добавить один аргумент (для выполнения команды в стиле C<execv>) с "
"использованием строки формата в стиле L<printf(3)>."

#. type: =head4
#: docs/internal-documentation.pod:381
msgid "Function C<lib/command.c:guestfs_int_cmd_add_string_unquoted>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_add_string_unquoted>"

#. type: verbatim
#: docs/internal-documentation.pod:383
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_add_string_unquoted (struct command *cmd, const char *str)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_add_string_unquoted (struct command *cmd, const char *str)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:386 docs/internal-documentation.pod:396
msgid "Add a string (for L<system(3)>-style command execution)."
msgstr "Добавить строку (для выполнения команды в стиле L<system(3)>)."

#. type: textblock
#: docs/internal-documentation.pod:388
msgid ""
"This variant adds the strings without quoting them, which is dangerous if "
"the string contains untrusted content."
msgstr ""
"Этот вариант добавляет строки без экранирования, что опасно, если строка "
"содержит недоверенное содержимое."

#. type: =head4
#: docs/internal-documentation.pod:391
msgid "Function C<lib/command.c:guestfs_int_cmd_add_string_quoted>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_add_string_quoted>"

#. type: verbatim
#: docs/internal-documentation.pod:393
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_add_string_quoted (struct command *cmd, const char *str)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_add_string_quoted (struct command *cmd, const char *str)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:398
msgid ""
"The string is enclosed in double quotes, with any special characters within "
"the string which need escaping done.  This is used to add a single argument "
"to a L<system(3)>-style command string."
msgstr ""
"Строка заключается в двойные кавычки, при этом специальные символы внутри "
"строки экранируются. Это используется для добавления одного аргумента к "
"строке команды в стиле L<system(3)>."

#. type: =head4
#: docs/internal-documentation.pod:403
msgid "Function C<lib/command.c:guestfs_int_cmd_set_stdout_callback>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_set_stdout_callback>"

#. type: verbatim
#: docs/internal-documentation.pod:405
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_set_stdout_callback (struct command *cmd,\n"
"                                      cmd_stdout_callback stdout_callback,\n"
"                                      void *stdout_data, unsigned flags)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_set_stdout_callback (struct command *cmd,\n"
"                                      cmd_stdout_callback stdout_callback,\n"
"                                      void *stdout_data, unsigned flags)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:410
msgid "Set a callback which will capture stdout."
msgstr "Установить обратный вызов, который будет перехватывать stdout."

#. type: textblock
#: docs/internal-documentation.pod:412
msgid ""
"If flags contains C<CMD_STDOUT_FLAG_LINE_BUFFER> (the default), then the "
"callback is called line by line on the output.  If there is a trailing "
"C<\\n> then it is automatically removed before the callback is called.  The "
"line buffer is C<\\0>-terminated."
msgstr ""
"Если flags содержит C<CMD_STDOUT_FLAG_LINE_BUFFER> (по умолчанию), то "
"обратный вызов вызывается построчно для вывода. Если в конце есть C<\\n>, он "
"автоматически удаляется перед вызовом обратного вызова. Буфер строки "
"завершается символом C<\\0>."

#. type: textblock
#: docs/internal-documentation.pod:417
msgid ""
"If flags contains C<CMD_STDOUT_FLAG_UNBUFFERED>, then buffers are passed to "
"the callback as it is received from the command.  Note in this case the "
"buffer is I<not> C<\\0>-terminated, so you need to may attention to the "
"length field in the callback."
msgstr ""
"Если flags содержит C<CMD_STDOUT_FLAG_UNBUFFERED>, то буферы передаются "
"обратному вызову по мере их получения от команды. Обратите внимание, что в "
"этом случае буфер I<не> завершается символом C<\\0>, поэтому вам нужно "
"обращать внимание на поле длины в обратном вызове."

#. type: textblock
#: docs/internal-documentation.pod:422
msgid ""
"If flags contains C<CMD_STDOUT_FLAG_WHOLE_BUFFER>, then the callback is "
"called exactly once, with the entire buffer.  Note in this case the buffer "
"is I<not> C<\\0>-terminated, so you need to may attention to the length "
"field in the callback."
msgstr ""
"Если flags содержит C<CMD_STDOUT_FLAG_WHOLE_BUFFER>, то обратный вызов "
"вызывается ровно один раз со всем буфером. Обратите внимание, что в этом "
"случае буфер I<не> завершается символом C<\\0>, поэтому вам нужно обращать "
"внимание на поле длины в обратном вызове."

#. type: =head4
#: docs/internal-documentation.pod:427
msgid "Function C<lib/command.c:guestfs_int_cmd_set_stderr_to_stdout>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_set_stderr_to_stdout>"

#. type: verbatim
#: docs/internal-documentation.pod:429
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_set_stderr_to_stdout (struct command *cmd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_set_stderr_to_stdout (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:432
msgid ""
"Equivalent to adding C<2E<gt>&1> to the end of the command.  This is "
"incompatible with the C<capture_errors> flag, because it doesn't make sense "
"to combine them."
msgstr ""
"Эквивалентно добавлению C<2E<gt>&1> в конец команды. Это несовместимо с "
"флагом C<capture_errors>, так как их комбинирование не имеет смысла."

#. type: =head4
#: docs/internal-documentation.pod:436
msgid "Function C<lib/command.c:guestfs_int_cmd_clear_capture_errors>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_clear_capture_errors>"

#. type: verbatim
#: docs/internal-documentation.pod:438
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_clear_capture_errors (struct command *cmd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_clear_capture_errors (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:441
msgid ""
"Clear the C<capture_errors> flag.  This means that any errors will go to "
"stderr, instead of being captured in the event log, and that is usually "
"undesirable."
msgstr ""
"Сбросить флаг C<capture_errors>. Это означает, что любые ошибки будут "
"направляться в stderr вместо перехвата в журнал событий, что обычно "
"нежелательно."

#. type: =head4
#: docs/internal-documentation.pod:445
msgid "Function C<lib/command.c:guestfs_int_cmd_set_child_callback>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_set_child_callback>"

#. type: verbatim
#: docs/internal-documentation.pod:447
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_set_child_callback (struct command *cmd,\n"
"                                     cmd_child_callback child_callback,\n"
"                                     void *data)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_set_child_callback (struct command *cmd,\n"
"                                     cmd_child_callback child_callback,\n"
"                                     void *data)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:452
msgid ""
"Set a function to be executed in the child, right before the execution.  Can "
"be used to setup the child, for example changing its current directory."
msgstr ""
"Установить функцию, которая будет выполнена в дочернем процессе, "
"непосредственно перед выполнением команды. Может использоваться для "
"настройки дочернего процесса, например, для изменения его текущего каталога."

#. type: =head4
#: docs/internal-documentation.pod:456
msgid "Function C<lib/command.c:guestfs_int_cmd_set_child_rlimit>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_set_child_rlimit>"

#. type: verbatim
#: docs/internal-documentation.pod:458
#, no-wrap
msgid ""
" void\n"
" guestfs_int_cmd_set_child_rlimit (struct command *cmd, int resource, long limit)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_cmd_set_child_rlimit (struct command *cmd, int resource, long limit)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:461
msgid ""
"Set up child rlimits, in case the process we are running could consume lots "
"of space or time."
msgstr ""
"Установить ограничения ресурсов для дочернего процесса, на случай, если "
"запускаемый процесс может потреблять много места или времени."

#. type: =head4
#: docs/internal-documentation.pod:464
msgid "Function C<lib/command.c:finish_command>"
msgstr "Функция C<lib/command.c:finish_command>"

#. type: verbatim
#: docs/internal-documentation.pod:466
#, no-wrap
msgid ""
" static void\n"
" finish_command (struct command *cmd)\n"
"\n"
msgstr ""
" static void\n"
" finish_command (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:469
msgid ""
"Finish off the command by either C<NULL>-terminating the argv array or "
"adding a terminating C<\\0> to the string, or die with an internal error if "
"no command has been added."
msgstr ""
"Завершает команду либо завершая массив argv элементом C<NULL>, либо добавляя "
"завершающий C<\\0> к строке, либо завершается с внутренней ошибкой, если "
"команда не была добавлена."

#. type: =head4
#: docs/internal-documentation.pod:473
msgid "Function C<lib/command.c:loop>"
msgstr "Функция C<lib/command.c:loop>"

#. type: verbatim
#: docs/internal-documentation.pod:475
#, no-wrap
msgid ""
" static int\n"
" loop (struct command *cmd)\n"
"\n"
msgstr ""
" static int\n"
" loop (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:478
msgid ""
"The loop which reads errors and output and directs it either to the log or "
"to the stdout callback as appropriate."
msgstr ""
"Цикл, который читает ошибки и вывод и направляет их либо в журнал, либо в "
"обратный вызов stdout, в зависимости от ситуации."

#. type: =head4
#: docs/internal-documentation.pod:481
msgid "Function C<lib/command.c:guestfs_int_cmd_run>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_run>"

#. type: verbatim
#: docs/internal-documentation.pod:483
#, no-wrap
msgid ""
" int\n"
" guestfs_int_cmd_run (struct command *cmd)\n"
"\n"
msgstr ""
" int\n"
" guestfs_int_cmd_run (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:486
msgid "Fork, run the command, loop over the output, and waitpid."
msgstr ""
"Выполняет fork, запускает команду, перебирает вывод и выполняет waitpid."

#. type: textblock
#: docs/internal-documentation.pod:488
msgid "Returns the exit status.  Test it using C<WIF*> macros."
msgstr "Возвращает статус выхода. Проверьте его с помощью макросов C<WIF*>."

#. type: textblock
#: docs/internal-documentation.pod:490
msgid "On error: Calls C<error> and returns C<-1>."
msgstr "В случае ошибки: вызывает C<error> и возвращает C<-1>."

#. type: =head4
#: docs/internal-documentation.pod:492
msgid "Function C<lib/command.c:guestfs_int_cmd_pipe_run>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_pipe_run>"

#. type: verbatim
#: docs/internal-documentation.pod:494
#, no-wrap
msgid ""
" int\n"
" guestfs_int_cmd_pipe_run (struct command *cmd, const char *mode)\n"
"\n"
msgstr ""
" int\n"
" guestfs_int_cmd_pipe_run (struct command *cmd, const char *mode)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:497
msgid ""
"Fork and run the command, but don't wait.  Roughly equivalent to S<C<popen "
"(..., \"r\"|\"w\")>>."
msgstr ""
"Выполняет fork и запускает команду, но не ждет. Примерно эквивалентно "
"S<C<popen (..., \"r\"|\"w\")>>."

#. type: textblock
#: docs/internal-documentation.pod:500
msgid ""
"Returns the file descriptor of the pipe, connected to stdout (C<\"r\">) or "
"stdin (C<\"w\">) of the child process."
msgstr ""
"Возвращает файловый дескриптор канала, подключенного к stdout (C<\"r\">) или "
"stdin (C<\"w\">) дочернего процесса."

#. type: textblock
#: docs/internal-documentation.pod:503
msgid ""
"After reading/writing to this pipe, call C<guestfs_int_cmd_pipe_wait> to "
"wait for the status of the child."
msgstr ""
"После чтения/записи в этот канал вызовите C<guestfs_int_cmd_pipe_wait>, "
"чтобы дождаться статуса дочернего процесса."

#. type: textblock
#: docs/internal-documentation.pod:506
msgid ""
"Errors from the subcommand cannot be captured to the error log using this "
"interface.  Instead the caller should call "
"C<guestfs_int_cmd_get_pipe_errors> (after C<guestfs_int_cmd_pipe_wait> "
"returns an error)."
msgstr ""
"Ошибки из подкоманды не могут быть перехвачены в журнал ошибок с помощью "
"этого интерфейса. Вместо этого вызывающий код должен вызвать "
"C<guestfs_int_cmd_get_pipe_errors> (после того как "
"C<guestfs_int_cmd_pipe_wait> возвращает ошибку)."

#. type: =head4
#: docs/internal-documentation.pod:511
msgid "Function C<lib/command.c:guestfs_int_cmd_pipe_wait>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_pipe_wait>"

#. type: verbatim
#: docs/internal-documentation.pod:513
#, no-wrap
msgid ""
" int\n"
" guestfs_int_cmd_pipe_wait (struct command *cmd)\n"
"\n"
msgstr ""
" int\n"
" guestfs_int_cmd_pipe_wait (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:516
msgid ""
"Wait for a subprocess created by C<guestfs_int_cmd_pipe_run> to finish.  On "
"error (eg. failed syscall) this returns C<-1> and sets the error.  If the "
"subcommand fails, then use C<WIF*> macros to check this, and call "
"C<guestfs_int_cmd_get_pipe_errors> to read the error messages printed by the "
"child."
msgstr ""
"Ожидает завершения подпроцесса, созданного C<guestfs_int_cmd_pipe_run>. В "
"случае ошибки (например, сбой системного вызова) возвращает C<-1> и "
"устанавливает ошибку. Если подкоманда завершается ошибкой, используйте "
"макросы C<WIF*> для проверки этого и вызовите "
"C<guestfs_int_cmd_get_pipe_errors>, чтобы прочитать сообщения об ошибках, "
"выведенные дочерним процессом."

#. type: =head4
#: docs/internal-documentation.pod:522
msgid "Function C<lib/command.c:guestfs_int_cmd_get_pipe_errors>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_get_pipe_errors>"

#. type: verbatim
#: docs/internal-documentation.pod:524
#, no-wrap
msgid ""
" char *\n"
" guestfs_int_cmd_get_pipe_errors (struct command *cmd)\n"
"\n"
msgstr ""
" char *\n"
" guestfs_int_cmd_get_pipe_errors (struct command *cmd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:527
msgid ""
"Read the error messages printed by the child.  The caller must free the "
"returned buffer after use."
msgstr ""
"Читает сообщения об ошибках, выведенные дочерним процессом. Вызывающий код "
"должен освободить возвращенный буфер после использования."

#. type: =head4
