#~ "call instead."
#~ msgstr ""
#~ "I<Эта функция устарела.> В новом коде используйте вызов L</selinux-"
#~ "relabel> вместо неё."

#~ msgid ""
#~ "I<This function is deprecated.> In new code, use the L</"
#~ "guestfs_selinux_relabel> call instead."
#~ msgstr ""
#~ "I<Эта функция устарела.> В новом коде используйте вызов L</"
#~ "guestfs_selinux_relabel>."

