#: lib/guestfs-actions.pod:3341 lib/guestfs-actions.pod:3433
#: lib/guestfs-actions.pod:3953 lib/guestfs-actions.pod:3995
#: lib/guestfs-actions.pod:4050 lib/guestfs-actions.pod:4084
#: lib/guestfs-actions.pod:4129 lib/guestfs-actions.pod:4866
