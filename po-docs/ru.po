"C<status> — это код завершения команды (например, возвращаемый L<waitpid(2)> "
"или L<system(3)>).  Эта функция преобразует код завершения в поясняющую "
"строку."

#. type: =head3
#: docs/internal-documentation.pod:865
msgid "File F<lib/events.c>"
msgstr "Файл F<lib/events.c>"

#. type: =head4
#: docs/internal-documentation.pod:867
msgid "Function C<lib/events.c:replace_old_style_event_callback>"
msgstr "Функция C<lib/events.c:replace_old_style_event_callback>"

#. type: verbatim
#: docs/internal-documentation.pod:869
#, no-wrap
msgid ""
" static void\n"
" replace_old_style_event_callback (guestfs_h *g,\n"
"                                   guestfs_event_callback cb,\n"
"                                   uint64_t event_bitmask,\n"
"                                   void *opaque,\n"
"                                   void *opaque2)\n"
"\n"
msgstr ""
" static void\n"
" replace_old_style_event_callback (guestfs_h *g,\n"
"                                   guestfs_event_callback cb,\n"
"                                   uint64_t event_bitmask,\n"
"                                   void *opaque,\n"
"                                   void *opaque2)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:876
msgid "Emulate old-style callback API."
msgstr "Эмулирует API обратных вызовов старого стиля."

#. type: textblock
#: docs/internal-documentation.pod:878
msgid ""
"There were no event handles, so multiple callbacks per event were not "
"supported.  Calling the same C<guestfs_set_*_callback> function would "
"replace the existing event.  Calling it with C<cb == NULL> meant that the "
"caller wanted to remove the callback."
msgstr ""
"Дескрипторов событий не существовало, поэтому множественные обратные вызовы "
"на одно событие не поддерживались.  Вызов одной и той же функции "
"C<guestfs_set_*_callback> заменял существующее событие.  Вызов с C<cb == "
"NULL> означал, что вызывающий хотел удалить обратный вызов."

#. type: =head3
#: docs/internal-documentation.pod:883
msgid "File F<lib/guestfs-internal-all.h>"
msgstr "Файл F<lib/guestfs-internal-all.h>"

#. type: textblock
#: docs/internal-documentation.pod:885
msgid ""
"This header contains definitions which are shared by all parts of "
"libguestfs, ie. the daemon, the library, language bindings and virt tools "
"(ie. I<all> C code)."
msgstr ""
"Этот заголовочный файл содержит определения, общие для всех частей "
"libguestfs, то есть для демона, библиотеки, привязок к языкам и virt-"
"инструментов (то есть I<всего> кода на C)."

#. type: textblock
#: docs/internal-documentation.pod:889
msgid ""
"If you need a definition used by only the library, put it in F<lib/guestfs-"
"internal.h> instead."
msgstr ""
"Если вам нужно определение, используемое только библиотекой, поместите его в "
"F<lib/guestfs-internal.h>."

#. type: textblock
#: docs/internal-documentation.pod:892
msgid ""
"If a definition is used by only a single tool, it should not be in any "
"shared header file at all."
msgstr ""
"Если определение используется только одним инструментом, его не должно быть "
"ни в одном общем заголовочном файле."

#. type: =head3
#: docs/internal-documentation.pod:895
msgid "File F<lib/guestfs-internal.h>"
msgstr "Файл F<lib/guestfs-internal.h>"

#. type: textblock
#: docs/internal-documentation.pod:897
msgid "This header file is included in the libguestfs library (F<lib/>)  only."
msgstr ""
"Этот заголовочный файл включается только в библиотеку libguestfs (F<lib/>)."

#. type: textblock
#: docs/internal-documentation.pod:900
msgid "See also F<lib/guestfs-internal-all.h>."
msgstr "Смотрите также F<lib/guestfs-internal-all.h>."

#. type: =head4
#: docs/internal-documentation.pod:902
msgid "Structure C<lib/guestfs-internal.h:event>"
msgstr "Структура C<lib/guestfs-internal.h:event>"

#. type: verbatim
#: docs/internal-documentation.pod:904
#, no-wrap
msgid ""
" struct event {\n"
"   uint64_t event_bitmask;\n"
"   guestfs_event_callback cb;\n"
"   void *opaque;\n"
" \n"
msgstr ""
" struct event {\n"
"   uint64_t event_bitmask;\n"
"   guestfs_event_callback cb;\n"
"   void *opaque;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:909
#, no-wrap
msgid ""
"   /* opaque2 is not exposed through the API, but is used internally to\n"
"    * emulate the old-style callback API.\n"
"    */\n"
"   void *opaque2;\n"
" };\n"
"\n"
msgstr ""
"   /* opaque2 не доступен через API, но используется внутри\n"
"    * для эмуляции API обратных вызовов старого стиля.\n"
"    */\n"
"   void *opaque2;\n"
" };\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:915
msgid ""
"This struct is used to maintain a list of events registered against the "
"handle.  See C<g-E<gt>events> in the handle."
msgstr ""
"Эта структура используется для ведения списка событий, зарегистрированных "
"для дескриптора.  Смотрите C<g-E<gt>events> в дескрипторе."

#. type: =head4
#: docs/internal-documentation.pod:918
msgid "Structure C<lib/guestfs-internal.h:drive>"
msgstr "Структура C<lib/guestfs-internal.h:drive>"

#. type: verbatim
#: docs/internal-documentation.pod:920
#, no-wrap
msgid ""
" struct drive {\n"
"   /* Original source of the drive, eg. file:..., http:... */\n"
"   struct drive_source src;\n"
" \n"
msgstr ""
" struct drive {\n"
"   /* Исходный источник диска, например file:..., http:... */\n"
"   struct drive_source src;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:924
#, no-wrap
msgid ""
"   /* If the drive is readonly, then an overlay [a local file] is\n"
"    * created before launch to protect the original drive content, and\n"
"    * the filename is stored here.  Backends should open this file if\n"
"    * it is non-NULL, else consult the original source above.\n"
"    *\n"
"    * Note that the overlay is in a backend-specific format, probably\n"
"    * different from the source format.  eg. qcow2\n"
"    */\n"
"   char *overlay;\n"
" \n"
msgstr ""
"   /* Если диск доступен только для чтения, то перед запуском создаётся\n"
"    * оверлей [локальный файл] для защиты исходного содержимого диска, и\n"
"    * имя файла сохраняется здесь.  Бэкенды должны открывать этот файл,\n"
"    * если он не NULL, в противном случае обращаться к исходному источнику выше.\n"
"    *\n"
"    * Обратите внимание, что оверлей имеет формат, специфичный для бэкенда,\n"
"    * вероятно, отличный от формата источника.  Например, qcow2.\n"
"    */\n"
"   char *overlay;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:934
#, no-wrap
msgid ""
"   /* Various per-drive flags. */\n"
"   bool readonly;\n"
"   char *name;\n"
"   char *disk_label;\n"
"   char *cachemode;\n"
"   enum discard discard;\n"
"   bool copyonread;\n"
"   int blocksize;\n"
" };\n"
"\n"
msgstr ""
"   /* Различные флаги для каждого диска. */\n"
"   bool readonly;\n"
"   char *name;\n"
"   char *disk_label;\n"
"   char *cachemode;\n"
"   enum discard discard;\n"
"   bool copyonread;\n"
"   int blocksize;\n"
" };\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:944
msgid "There is one C<struct drive> per drive."
msgstr "Для каждого диска существует одна структура C<struct drive>."

#. type: =head4
#: docs/internal-documentation.pod:946
msgid "Structure C<lib/guestfs-internal.h:backend_ops>"
msgstr "Структура C<lib/guestfs-internal.h:backend_ops>"

#. type: verbatim
#: docs/internal-documentation.pod:948
#, no-wrap
msgid ""
" struct backend_ops {\n"
"   /* Size (in bytes) of the per-handle data structure needed by this\n"
"    * backend.  The data pointer is allocated and freed by libguestfs\n"
"    * and passed to the functions in the 'void *data' parameter.\n"
"    * Inside the data structure is opaque to libguestfs.  Any strings\n"
"    * etc pointed to by it must be freed by the backend during\n"
"    * shutdown.\n"
"    */\n"
"   size_t data_size;\n"
" \n"
msgstr ""
" struct backend_ops {\n"
"   /* Размер (в байтах) структуры данных для каждого дескриптора,\n"
"    * необходимой этому бэкенду.  Указатель на данные выделяется\n"
"    * и освобождается libguestfs и передаётся функциям\n"
"    * в параметре 'void *data'.\n"
"    * Внутреннее содержимое структуры данных непрозрачно для libguestfs.\n"
"    * Любые строки и т.п., на которые она указывает, должны быть\n"
"    * освобождены бэкендом во время завершения работы.\n"
"    */\n"
"   size_t data_size;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:958
#, no-wrap
msgid ""
"   /* Create a COW overlay on top of a drive.  This must be a local\n"
"    * file, created in the temporary directory.  This is called when\n"
"    * the drive is added to the handle.\n"
"    */\n"
"   char *(*create_cow_overlay) (guestfs_h *g, void *data, struct drive *drv);\n"
" \n"
msgstr ""
"   /* Создать COW-оверлей поверх диска.  Это должен быть локальный\n"
"    * файл, созданный во временном каталоге.  Вызывается, когда\n"
"    * диск добавляется в дескриптор.\n"
"    */\n"
"   char *(*create_cow_overlay) (guestfs_h *g, void *data, struct drive *drv);\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:964
#, no-wrap
msgid ""
"   /* Get the default hypervisor (qemu), if the user does not override\n"
"    * this by calling guestfs_set_hv or setting LIBGUESTFS_HV.\n"
"    */\n"
"   const char *(*get_default_hv) (guestfs_h *g, void *data);\n"
" \n"
msgstr ""
"   /* Получить гипервизор по умолчанию (qemu), если пользователь не\n"
"    * переопределяет его вызовом guestfs_set_hv или установкой\n"
"    * переменной LIBGUESTFS_HV.\n"
"    */\n"
"   const char *(*get_default_hv) (guestfs_h *g, void *data);\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:969
#, no-wrap
msgid ""
"   /* Launch and shut down. */\n"
"   int (*launch) (guestfs_h *g, void *data, const char *arg);\n"
"   int (*shutdown) (guestfs_h *g, void *data, int check_for_errors);\n"
" \n"
msgstr ""
"   /* Запуск и завершение работы. */\n"
"   int (*launch) (guestfs_h *g, void *data, const char *arg);\n"
"   int (*shutdown) (guestfs_h *g, void *data, int check_for_errors);\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:973
#, no-wrap
msgid ""
"   /* Miscellaneous. */\n"
"   int (*get_pid) (guestfs_h *g, void *data);\n"
"   int (*max_disks) (guestfs_h *g, void *data);\n"
" };\n"
"\n"
msgstr ""
"   /* Разное. */\n"
"   int (*get_pid) (guestfs_h *g, void *data);\n"
"   int (*max_disks) (guestfs_h *g, void *data);\n"
" };\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:978
msgid "Backend operations."
msgstr "Операции бэкенда."

#. type: textblock
#: docs/internal-documentation.pod:980
msgid ""
"Each backend (eg. libvirt, direct) defines some functions which get run at "
"various places in the handle lifecycle (eg. at launch, shutdown).  The "
"backend defines this struct pointing to those functions."
msgstr ""
"Каждый бэкенд (например, libvirt, direct) определяет некоторые функции, "
"которые выполняются в различных точках жизненного цикла дескриптора "
"(например, при запуске, завершении работы). Бэкенд определяет эту структуру, "
"указывающую на эти функции."

#. type: =head4
#: docs/internal-documentation.pod:985
msgid "Structure C<lib/guestfs-internal.h:connection>"
msgstr "Структура C<lib/guestfs-internal.h:connection>"

#. type: verbatim
#: docs/internal-documentation.pod:987
#, no-wrap
msgid ""
" struct connection {\n"
"   const struct connection_ops *ops;\n"
" \n"
msgstr ""
" struct connection {\n"
"   const struct connection_ops *ops;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:990
#, no-wrap
msgid ""
"   /* In the real struct, private data used by each connection module\n"
"    * follows here.\n"
"    */\n"
" };\n"
"\n"
msgstr ""
"   /* В реальной структуре здесь следуют приватные данные,\n"
"    * используемые каждым модулем соединения.\n"
"    */\n"
" };\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:995
msgid "Connection module."
msgstr "Модуль соединения."

#. type: textblock
#: docs/internal-documentation.pod:997
msgid ""
"A C<connection> represents the appliance console connection plus the daemon "
"connection.  It hides the underlying representation (POSIX sockets, "
"C<virStreamPtr>)."
msgstr ""
"C<connection> представляет собой соединение с консолью приложения и "
"соединение с демоном.  Он скрывает базовое представление (сокеты POSIX, "
"C<virStreamPtr>)."

#. type: =head4
#: docs/internal-documentation.pod:1001
msgid "Structure C<lib/guestfs-internal.h:cached_feature>"
msgstr "Структура C<lib/guestfs-internal.h:cached_feature>"

#. type: verbatim
#: docs/internal-documentation.pod:1003
#, no-wrap
msgid ""
" struct cached_feature {\n"
"   char *group;\n"
"   int result;\n"
" };\n"
"\n"
msgstr ""
" struct cached_feature {\n"
"   char *group;\n"
"   int result;\n"
" };\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:1008
msgid "Cache of queried features."
msgstr "Кэш запрошенных возможностей."

#. type: textblock
#: docs/internal-documentation.pod:1010
msgid "Used to cache the appliance features (see F<lib/available.c>)."
msgstr ""
"Используется для кэширования возможностей приложения (см. F<lib/"
"available.c>)."

#. type: =head4
#: docs/internal-documentation.pod:1012
msgid "Structure C<lib/guestfs-internal.h:guestfs_h>"
msgstr "Структура C<lib/guestfs-internal.h:guestfs_h>"

#. type: verbatim
#: docs/internal-documentation.pod:1014
#, no-wrap
msgid ""
" struct guestfs_h {\n"
"   struct guestfs_h *next;\t/* Linked list of open handles. */\n"
"   enum state state;             /* See the state machine diagram in guestfs(3)*/\n"
" \n"
msgstr ""
" struct guestfs_h {\n"
"   struct guestfs_h *next;\t/* Связный список открытых дескрипторов. */\n"
"   enum state state;             /* Смотрите диаграмму конечного автомата в guestfs(3) */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1018
#, no-wrap
msgid ""
"   /* Lock acquired when entering any public guestfs_* function to\n"
"    * protect the handle.\n"
"    */\n"
"   pthread_mutex_t lock;\n"
" \n"
msgstr ""
"   /* Блокировка, захватываемая при входе в любую публичную функцию guestfs_*\n"
"    * для защиты дескриптора.\n"
"    */\n"
"   pthread_mutex_t lock;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1023
#, no-wrap
msgid ""
"   /**** Configuration of the handle. ****/\n"
"   bool verbose;                 /* Debugging. */\n"
"   bool trace;                   /* Trace calls. */\n"
"   bool autosync;                /* Autosync. */\n"
"   bool direct_mode;             /* Direct mode. */\n"
"   bool recovery_proc;           /* Create a recovery process. */\n"
"   bool enable_network;          /* Enable the network. */\n"
"   bool selinux;                 /* selinux enabled? */\n"
"   bool pgroup;                  /* Create process group for children? */\n"
"   bool close_on_exit;           /* Is this handle on the atexit list? */\n"
" \n"
msgstr ""
"   /**** Конфигурация дескриптора. ****/\n"
"   bool verbose;                 /* Отладка. */\n"
"   bool trace;                   /* Трассировка вызовов. */\n"
"   bool autosync;                /* Автосинхронизация. */\n"
"   bool direct_mode;             /* Прямой режим. */\n"
"   bool recovery_proc;           /* Создать процесс восстановления. */\n"
"   bool enable_network;          /* Включить сеть. */\n"
"   bool selinux;                 /* SELinux включён? */\n"
"   bool pgroup;                  /* Создать группу процессов для дочерних? */\n"
"   bool close_on_exit;           /* Находится ли этот дескриптор в списке atexit? */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1034
#, no-wrap
msgid ""
"   int smp;                      /* If > 1, -smp flag passed to hv. */\n"
"   int memsize;\t\t\t/* Size of RAM (megabytes). */\n"
" \n"
msgstr ""
"   int smp;                      /* Если > 1, флаг -smp передаётся гипервизору. */\n"
"   int memsize;\t\t\t/* Размер ОЗУ (мегабайт). */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1037
#, no-wrap
msgid ""
"   char *path;\t\t\t/* Path to the appliance. */\n"
"   char *hv;\t\t\t/* Hypervisor (HV) binary. */\n"
"   char *append;\t\t\t/* Append to kernel command line. */\n"
" \n"
msgstr ""
"   char *path;\t\t\t/* Путь к приложению. */\n"
"   char *hv;\t\t\t/* Исполняемый файл гипервизора (HV). */\n"
"   char *append;\t\t\t/* Добавить к командной строке ядра. */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1041
#, no-wrap
msgid ""
"   struct hv_param *hv_params;   /* Extra hv parameters. */\n"
" \n"
msgstr ""
"   struct hv_param *hv_params;   /* Дополнительные параметры гипервизора. */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1043
#, no-wrap
msgid ""
"   char *program;                /* Program name. */\n"
"   char *identifier;             /* Handle identifier. */\n"
" \n"
msgstr ""
"   char *program;                /* Имя программы. */\n"
"   char *identifier;             /* Идентификатор дескриптора. */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1046
#, no-wrap
msgid ""
"   /* Array of drives added by add-drive* APIs.\n"
"    *\n"
"    * Before launch this list can be empty or contain some drives.\n"
"    *\n"
"    * During launch, a dummy slot may be added which represents the\n"
"    * slot taken up by the appliance drive.\n"
"    *\n"
"    * During shutdown, this list is deleted, so that each launch gets a\n"
"    * fresh set of drives (however callers: don't do this, create a new\n"
"    * handle each time).\n"
"    *\n"
"    * Always use ITER_DRIVES macro to iterate over this list!\n"
"    */\n"
"   struct drive **drives;\n"
"   size_t nr_drives;\n"
" \n"
msgstr ""
"   /* Массив дисков, добавленных API add-drive*.\n"
"    *\n"
"    * До запуска этот список может быть пустым или содержать несколько дисков.\n"
"    *\n"
"    * Во время запуска может быть добавлен фиктивный слот, представляющий\n"
"    * слот, занимаемый диском приложения.\n"
"    *\n"
"    * Во время завершения работы этот список удаляется, чтобы каждый запуск\n"
"    * получал новый набор дисков (однако вызывающие стороны: не делайте этого,\n"
"    * создавайте новый дескриптор каждый раз).\n"
"    *\n"
"    * Всегда используйте макрос ITER_DRIVES для перебора этого списка!\n"
"    */\n"
"   struct drive **drives;\n"
"   size_t nr_drives;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1062
#, no-wrap
msgid ""
" #define ITER_DRIVES(g,i,drv)              \\\n"
"   for (i = 0; i < (g)->nr_drives; ++i)    \\\n"
"     if (((drv) = (g)->drives[i]) != NULL)\n"
" \n"
msgstr ""
" #define ITER_DRIVES(g,i,drv)              \\\n"
"   for (i = 0; i < (g)->nr_drives; ++i)    \\\n"
"     if (((drv) = (g)->drives[i]) != NULL)\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1066
#, no-wrap
msgid ""
"   /* Backend.  NB: Use guestfs_int_set_backend to change the backend. */\n"
"   char *backend;                /* The full string, always non-NULL. */\n"
"   char *backend_arg;            /* Pointer to the argument part. */\n"
"   const struct backend_ops *backend_ops;\n"
"   void *backend_data;           /* Per-handle data. */\n"
"   char **backend_settings;      /* Backend settings (can be NULL). */\n"
" \n"
msgstr ""
"   /* Бэкенд.  Примечание: используйте guestfs_int_set_backend для изменения бэкенда. */\n"
"   char *backend;                /* Полная строка, всегда не NULL. */\n"
"   char *backend_arg;            /* Указатель на часть аргумента. */\n"
"   const struct backend_ops *backend_ops;\n"
"   void *backend_data;           /* Данные для каждого дескриптора. */\n"
"   char **backend_settings;      /* Настройки бэкенда (может быть NULL). */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1073
#, no-wrap
msgid ""
"   /**** Runtime information. ****/\n"
"   /* Temporary and cache directories. */\n"
"   /* The actual temporary directory - this is not created with the\n"
"    * handle, you have to call guestfs_int_lazy_make_tmpdir.\n"
"    */\n"
"   char *tmpdir;\n"
"   char *sockdir;\n"
"   /* Environment variables that affect tmpdir/cachedir/sockdir locations. */\n"
"   char *env_tmpdir;             /* $TMPDIR (NULL if not set) */\n"
"   char *env_runtimedir;         /* $XDG_RUNTIME_DIR (NULL if not set)*/\n"
"   char *int_tmpdir;   /* $LIBGUESTFS_TMPDIR or guestfs_set_tmpdir or NULL */\n"
"   char *int_cachedir; /* $LIBGUESTFS_CACHEDIR or guestfs_set_cachedir or NULL */\n"
" \n"
msgstr ""
"   /**** Информация времени выполнения. ****/\n"
"   /* Временные и кэширующие каталоги. */\n"
"   /* Фактический временный каталог - он не создаётся вместе с\n"
"    * дескриптором, вы должны вызвать guestfs_int_lazy_make_tmpdir.\n"
"    */\n"
"   char *tmpdir;\n"
"   char *sockdir;\n"
"   /* Переменные окружения, влияющие на расположение tmpdir/cachedir/sockdir. */\n"
"   char *env_tmpdir;             /* $TMPDIR (NULL, если не установлена) */\n"
"   char *env_runtimedir;         /* $XDG_RUNTIME_DIR (NULL, если не установлена)*/\n"
"   char *int_tmpdir;   /* $LIBGUESTFS_TMPDIR или guestfs_set_tmpdir или NULL */\n"
"   char *int_cachedir; /* $LIBGUESTFS_CACHEDIR или guestfs_set_cachedir или NULL */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1086
#, no-wrap
msgid ""
"   /* Error handler, plus stack of old error handlers. */\n"
"   pthread_key_t error_data;\n"
" \n"
msgstr ""
"   /* Обработчик ошибок и стек старых обработчиков ошибок. */\n"
"   pthread_key_t error_data;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1089
#, no-wrap
msgid ""
"   /* Linked list of error_data structures allocated for this handle,\n"
"    * plus a mutex to protect the linked list.\n"
"    */\n"
"   pthread_mutex_t error_data_list_lock;\n"
"   struct error_data *error_data_list;\n"
" \n"
msgstr ""
"   /* Связный список структур error_data, выделенных для этого дескриптора,\n"
"    * и мьютекс для защиты связного списка.\n"
"    */\n"
"   pthread_mutex_t error_data_list_lock;\n"
"   struct error_data *error_data_list;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1095
#, no-wrap
msgid ""
"   /* Out of memory error handler. */\n"
"   guestfs_abort_cb           abort_cb;\n"
" \n"
msgstr ""
"   /* Обработчик ошибок нехватки памяти. */\n"
"   guestfs_abort_cb           abort_cb;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1098
#, no-wrap
msgid ""
"   /* Events. */\n"
"   struct event *events;\n"
"   size_t nr_events;\n"
" \n"
msgstr ""
"   /* События. */\n"
"   struct event *events;\n"
"   size_t nr_events;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1102
#, no-wrap
msgid ""
"   /* Private data area. */\n"
"   struct hash_table *pda;\n"
"   struct pda_entry *pda_next;\n"
" \n"
msgstr ""
"   /* Область приватных данных. */\n"
"   struct hash_table *pda;\n"
"   struct pda_entry *pda_next;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1106
#, no-wrap
msgid ""
"   /* User cancelled transfer.  Not signal-atomic, but it doesn't\n"
"    * matter for this case because we only care if it is != 0.\n"
"    */\n"
"   int user_cancel;\n"
" \n"
msgstr ""
"   /* Пользователь отменил передачу.  Не сигнал-атомарно, но для\n"
"    * этого случая это не имеет значения, поскольку нас интересует только\n"
"    * != 0.\n"
"    */\n"
"   int user_cancel;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1111
#, no-wrap
msgid ""
"   struct timeval launch_t;      /* The time that we called guestfs_launch. */\n"
" \n"
msgstr ""
"   struct timeval launch_t;      /* Время вызова guestfs_launch. */\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1113
#, no-wrap
msgid ""
"   /* Used by bindtests. */\n"
"   FILE *test_fp;\n"
" \n"
msgstr ""
"   /* Используется bindtests. */\n"
"   FILE *test_fp;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1116
#, no-wrap
msgid ""
"   /* Used to generate unique numbers, eg for temp files.  To use this,\n"
"    * '++g->unique'.  Note these are only unique per-handle, not\n"
"    * globally unique.\n"
"    */\n"
"   int unique;\n"
" \n"
msgstr ""
"   /* Используется для генерации уникальных номеров, например для временных\n"
"    * файлов.  Для использования: '++g->unique'.  Обратите внимание, что они\n"
"    * уникальны только для каждого дескриптора, а не глобально.\n"
"    */\n"
"   int unique;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1122
#, no-wrap
msgid ""
"   /*** Protocol. ***/\n"
"   struct connection *conn;              /* Connection to appliance. */\n"
"   int msg_next_serial;\n"
" \n"
msgstr ""
"   /*** Протокол. ***/\n"
"   struct connection *conn;              /* Соединение с приложением. */\n"
"   int msg_next_serial;\n"
" \n"

#. type: verbatim
#: docs/internal-documentation.pod:1126
#, no-wrap
msgid ""
" #if HAVE_FUSE\n"
"   /**** Used by the mount-local APIs. ****/\n"
