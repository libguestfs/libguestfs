#: docs/guestfs-faq.pod:292 docs/guestfs-faq.pod:322 docs/guestfs-faq.pod:345
#, no-wrap
msgid ""
" sudo chmod 0644 /boot/vmlinuz*\n"
"\n"
msgstr ""
" sudo chmod 0644 /boot/vmlinuz*\n"
"\n"

#. type: textblock
#: docs/guestfs-faq.pod:294
