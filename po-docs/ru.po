#. type: verbatim
#: lib/guestfs-actions.pod:1256
#, no-wrap
msgid ""
" int\n"
" guestfs_blkdiscard (guestfs_h *g,\n"
"                     const char *device);\n"
"\n"
msgstr ""
" int\n"
" guestfs_blkdiscard (guestfs_h *g,\n"
"                     const char *device);\n"
"\n"

#. type: textblock
#: lib/guestfs-actions.pod:1263
msgid ""
"This operation requires support in libguestfs, the host filesystem, qemu and "
"the host kernel.  If this support isn't present it may give an error or even "
"appear to run but do nothing.  You must also set the C<discard> attribute on "
"the underlying drive (see C<guestfs_add_drive_opts>)."
msgstr ""
"Эта операция требует поддержки в libguestfs, файловой системе хоста, qemu и "
"ядре хоста.  Если эта поддержка отсутствует, это может вызвать ошибку или "
"даже казаться выполняющейся, но ничего не делать.  Вы также должны "
"установить атрибут C<discard> на нижележащем диске (см. "
"C<guestfs_add_drive_opts>)."

#. type: textblock
#: lib/guestfs-actions.pod:1271
msgid ""
"This function depends on the feature C<blkdiscard>.  See also L</"
"guestfs_feature_available>."
msgstr ""
"Эта функция зависит от возможности C<blkdiscard>.  См. также L</"
"guestfs_feature_available>."

#. type: textblock
#: lib/guestfs-actions.pod:1274 lib/guestfs-actions.pod:1294
msgid "(Added in 1.25.44)"
msgstr "(Добавлено в 1.25.44)"

#. type: =head2
#: lib/guestfs-actions.pod:1276
msgid "guestfs_blkdiscardzeroes"
msgstr "guestfs_blkdiscardzeroes"

#. type: verbatim
#: lib/guestfs-actions.pod:1278
#, no-wrap
