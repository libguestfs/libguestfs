" struct command *\n"
" guestfs_int_new_command (guestfs_h *g)\n"
"\n"
msgstr ""
" struct command *\n"
" guestfs_int_new_command (guestfs_h *g)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:364
msgid "Create a new command handle."
msgstr "Создает новый дескриптор команды."

#. type: =head4
#: docs/internal-documentation.pod:366
msgid "Function C<lib/command.c:guestfs_int_cmd_add_arg>"
msgstr "Функция C<lib/command.c:guestfs_int_cmd_add_arg>"

#. type: verbatim
#: docs/internal-documentation.pod:368
#, no-wrap
