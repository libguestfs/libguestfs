#. type: =head3
#: docs/internal-documentation.pod:297
msgid "File F<lib/command.c>"
msgstr "Файл F<lib/command.c>"

#. type: textblock
#: docs/internal-documentation.pod:299
msgid ""
"A wrapper for running external commands, loosely based on libvirt's "
"C<virCommand> interface."
msgstr ""
"Обертка для запуска внешних команд, основанная на интерфейсе C<virCommand> "
"из libvirt."

#. type: textblock
#: docs/internal-documentation.pod:302
msgid "In outline to use this interface you must:"
msgstr "В общих чертах, чтобы использовать этот интерфейс, вы должны:"

#. type: textblock
#: docs/internal-documentation.pod:308
msgid "Create a new command handle:"
msgstr "Создать новый дескриптор команды:"

#. type: verbatim
#: docs/internal-documentation.pod:310
#, no-wrap
msgid ""
" struct command *cmd;\n"
" cmd = guestfs_int_new_command (g);\n"
"\n"
msgstr ""
" struct command *cmd;\n"
" cmd = guestfs_int_new_command (g);\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:315
msgid "I<Either> add arguments:"
msgstr "I<Либо> добавьте аргументы:"

#. type: verbatim
#: docs/internal-documentation.pod:317
#, no-wrap
msgid ""
" guestfs_int_cmd_add_arg (cmd, \"qemu-img\");\n"
" guestfs_int_cmd_add_arg (cmd, \"info\");\n"
" guestfs_int_cmd_add_arg (cmd, filename);\n"
"\n"
msgstr ""
" guestfs_int_cmd_add_arg (cmd, \"qemu-img\");\n"
" guestfs_int_cmd_add_arg (cmd, \"info\");\n"
" guestfs_int_cmd_add_arg (cmd, filename);\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:321
msgid "(B<NB:> You don't need to add a C<NULL> argument at the end.)"
msgstr "(B<Примечание:> Вам не нужно добавлять аргумент C<NULL> в конце.)"

#. type: textblock
#: docs/internal-documentation.pod:325
msgid ""
"I<Or> construct a command using a mix of quoted and unquoted strings.  (This "
"is useful for L<system(3)>/C<popen(\"r\")>-style shell commands, with the "
"added safety of allowing args to be quoted properly)."
msgstr ""
"I<Или> создайте команду, используя смесь строк в кавычках и без кавычек. "
"(Это полезно для команд оболочки в стиле L<system(3)>/C<popen(\"r\")>, с "
"дополнительной безопасностью, позволяющей правильно экранировать аргументы)."

#. type: verbatim
#: docs/internal-documentation.pod:330
#, no-wrap
msgid ""
" guestfs_int_cmd_add_string_unquoted (cmd, \"qemu-img info \");\n"
" guestfs_int_cmd_add_string_quoted (cmd, filename);\n"
"\n"
msgstr ""
" guestfs_int_cmd_add_string_unquoted (cmd, \"qemu-img info \");\n"
" guestfs_int_cmd_add_string_quoted (cmd, filename);\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:335
msgid ""
"Set various flags, such as whether you want to capture errors in the regular "
"libguestfs error log."
msgstr ""
"Установите различные флаги, например, хотите ли вы перехватывать ошибки в "
"обычный журнал ошибок libguestfs."

#. type: textblock
#: docs/internal-documentation.pod:340
msgid ""
"Run the command.  This is what does the L<fork(2)> call, optionally loops "
"over the output, and then does a L<waitpid(3)> and returns the exit status "
"of the command."
msgstr ""
"Запустите команду. Это то, что выполняет вызов L<fork(2)>, при необходимости "
"перебирает вывод, а затем выполняет L<waitpid(3)> и возвращает статус выхода "
"команды."

#. type: verbatim
#: docs/internal-documentation.pod:344
#, no-wrap
msgid ""
" r = guestfs_int_cmd_run (cmd);\n"
" if (r == -1)\n"
"   // error\n"
" // else test r using the WIF* functions\n"
"\n"
msgstr ""
" r = guestfs_int_cmd_run (cmd);\n"
" if (r == -1)\n"
"   // ошибка\n"
" // иначе проверьте r с помощью функций WIF*\n"
"\n"

#. type: =item
#: docs/internal-documentation.pod:349 rescue/virt-rescue.pod:454
msgid "6."
msgstr "6."

#. type: textblock
#: docs/internal-documentation.pod:351
msgid "Close the handle:"
msgstr "Закройте дескриптор:"

#. type: verbatim
#: docs/internal-documentation.pod:353
#, no-wrap
msgid ""
" guestfs_int_cmd_close (cmd);\n"
"\n"
msgstr ""
" guestfs_int_cmd_close (cmd);\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:355
msgid "(or use C<CLEANUP_CMD_CLOSE>)."
msgstr "(или используйте C<CLEANUP_CMD_CLOSE>)."

