#. type: =item
#: docs/guestfs-release-notes-1.20.pod:457
msgid "L<https://bugzilla.redhat.com/860235>"
msgstr "L<https://bugzilla.redhat.com/860235>"

#. type: textblock
#: docs/guestfs-release-notes-1.20.pod:459
