" guestfs_int_waitpid_noerror (pid_t pid)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_waitpid_noerror (pid_t pid)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:2131
msgid "Like C<guestfs_int_waitpid>, but ignore errors."
msgstr "Как C<guestfs_int_waitpid>, но игнорирует ошибки."

#. type: =head4
#: docs/internal-documentation.pod:2133
