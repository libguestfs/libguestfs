msgstr "Для образа диска, содержащего файловую систему extX, возвращает UUID."

#. type: =head4
#: docs/internal-documentation.pod:77
msgid "Function C<lib/appliance-kcmdline.c:run_qemu_img_dd>"
msgstr "Функция C<lib/appliance-kcmdline.c:run_qemu_img_dd>"

#. type: verbatim
