" int\n"
" guestfs_int_is_true (const char *str)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3118
msgid "Similar to C<Tcl_GetBoolean>."
msgstr "Аналогично C<Tcl_GetBoolean>."

#. type: =head4
#: docs/internal-documentation.pod:3120
msgid "Function C<common/utils/utils.c:guestfs_int_string_is_valid>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_string_is_valid>"

#. type: verbatim
#: docs/internal-documentation.pod:3122
#, no-wrap
msgid ""
" bool\n"
" guestfs_int_string_is_valid (const char *str,\n"
"                              size_t min_length, size_t max_length,\n"
"                              int flags, const char *extra)\n"
"\n"
msgstr ""
" bool\n"
" guestfs_int_string_is_valid (const char *str,\n"
"                              size_t min_length, size_t max_length,\n"
"                              int flags, const char *extra)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3127
msgid ""
"Check a string for validity, that it contains only certain characters, and "
"minimum and maximum length.  This function is usually wrapped in a VALID_* "
"macro, see F<lib/drives.c> for an example."
msgstr ""
"Проверяет строку на допустимость, что она содержит только определённые "
"символы, и на минимальную и максимальную длину.  Эта функция обычно "
"оборачивается в макрос VALID_*, см. F<lib/drives.c> для примера."

#. type: textblock
#: docs/internal-documentation.pod:3132
msgid "C<str> is the string to check."
msgstr "C<str> — проверяемая строка."

#. type: textblock
#: docs/internal-documentation.pod:3134
msgid ""
"C<min_length> and C<max_length> are the minimum and maximum length checks.  "
"C<0> means no check."
msgstr ""
"C<min_length> и C<max_length> — проверки минимальной и максимальной длины.  "
"C<0> означает отсутствие проверки."

#. type: textblock
#: docs/internal-documentation.pod:3137
msgid "The flags control:"
msgstr "Флаги управляют:"

#. type: =item
#: docs/internal-documentation.pod:3141
msgid "C<VALID_FLAG_ALPHA>"
msgstr "C<VALID_FLAG_ALPHA>"

#. type: textblock
#: docs/internal-documentation.pod:3143
msgid "7-bit ASCII-only alphabetic characters are permitted."
msgstr "Разрешены только буквенные символы 7-битного ASCII."

#. type: =item
#: docs/internal-documentation.pod:3145
msgid "C<VALID_FLAG_DIGIT>"
msgstr "C<VALID_FLAG_DIGIT>"

#. type: textblock
#: docs/internal-documentation.pod:3147
msgid "7-bit ASCII-only digits are permitted."
msgstr "Разрешены только цифры 7-битного ASCII."

#. type: textblock
#: docs/internal-documentation.pod:3151
msgid ""
"C<extra> is a set of extra characters permitted, in addition to alphabetic "
"and/or digits.  (C<extra = NULL> for no extra)."
msgstr ""
"C<extra> — набор дополнительных разрешённых символов, помимо буквенных и/или "
"цифр.  (C<extra = NULL> — без дополнительных)."

#. type: textblock
#: docs/internal-documentation.pod:3154
msgid ""
"Returns boolean C<true> if the string is valid (passes all the tests), or "
"C<false> if not."
msgstr ""
"Возвращает логическое C<true>, если строка допустима (проходит все тесты), "
"или C<false>, если нет."

#. type: =head4
#: docs/internal-documentation.pod:3157
msgid "Function C<common/utils/utils.c:guestfs_int_fadvise_normal>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_fadvise_normal>"

#. type: verbatim
#: docs/internal-documentation.pod:3159
#, no-wrap
msgid ""
" void\n"
" guestfs_int_fadvise_normal (int fd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_fadvise_normal (int fd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3162
msgid "Hint that we will read or write the file descriptor normally."
msgstr ""
"Подсказывает, что мы будем читать или записывать дескриптор файла обычным "
"образом."

#. type: textblock
#: docs/internal-documentation.pod:3164
msgid ""
"On Linux, this clears the C<FMODE_RANDOM> flag on the file [see below] and "
"sets the per-file number of readahead pages to equal the block device "
"readahead setting."
msgstr ""
"В Linux это сбрасывает флаг C<FMODE_RANDOM> в файле [см. ниже] и "
"устанавливает количество страниц упреждающего чтения для файла, равное "
"настройке упреждающего чтения блочного устройства."

#. type: textblock
#: docs/internal-documentation.pod:3168 docs/internal-documentation.pod:3182
#: docs/internal-documentation.pod:3209 docs/internal-documentation.pod:3221
#: docs/internal-documentation.pod:3238 docs/internal-documentation.pod:3252
msgid ""
"It's OK to call this on a non-file since we ignore failure as it is only a "
"hint."
msgstr ""
"Можно вызывать это для не-файла, поскольку мы игнорируем ошибку, так как это "
"всего лишь подсказка."

#. type: =head4
#: docs/internal-documentation.pod:3171
msgid "Function C<common/utils/utils.c:guestfs_int_fadvise_sequential>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_fadvise_sequential>"

#. type: verbatim
#: docs/internal-documentation.pod:3173
#, no-wrap
msgid ""
" void\n"
" guestfs_int_fadvise_sequential (int fd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_fadvise_sequential (int fd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3176
msgid "Hint that we will read or write the file descriptor sequentially."
msgstr ""
"Подсказывает, что мы будем читать или записывать дескриптор файла "
"последовательно."

#. type: textblock
#: docs/internal-documentation.pod:3178
msgid ""
"On Linux, this clears the C<FMODE_RANDOM> flag on the file [see below] and "
"sets the per-file number of readahead pages to twice the block device "
"readahead setting."
msgstr ""
"В Linux это сбрасывает флаг C<FMODE_RANDOM> в файле [см. ниже] и "
"устанавливает количество страниц упреждающего чтения для файла, равное "
"удвоенной настройке упреждающего чтения блочного устройства."

#. type: =head4
#: docs/internal-documentation.pod:3185
msgid "Function C<common/utils/utils.c:guestfs_int_fadvise_random>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_fadvise_random>"

#. type: verbatim
#: docs/internal-documentation.pod:3187
#, no-wrap
msgid ""
" void\n"
" guestfs_int_fadvise_random (int fd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_fadvise_random (int fd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3190
msgid "Hint that we will read or write the file descriptor randomly."
msgstr ""
"Подсказывает, что мы будем читать или записывать дескриптор файла случайным "
"образом."

#. type: textblock
#: docs/internal-documentation.pod:3192
msgid ""
"On Linux, this sets the C<FMODE_RANDOM> flag on the file.  The effect of "
"this flag is to:"
msgstr ""
"В Linux это устанавливает флаг C<FMODE_RANDOM> в файле.  Эффект этого флага:"

#. type: textblock
#: docs/internal-documentation.pod:3199
msgid "Disable normal sequential file readahead."
msgstr "Отключает обычное последовательное упреждающее чтение файлов."

#. type: textblock
#: docs/internal-documentation.pod:3203
msgid ""
"If any read of the file is done which misses in the page cache, 2MB are read "
"into the page cache.  [I think - I'm not sure I totally understand what this "
"is doing]"
msgstr ""
"Если при любом чтении файла происходит промах в кэше страниц, в кэш страниц "
"читается 2 МБ.  [Я думаю — я не уверен, что полностью понимаю, что это "
"делает]"

#. type: =head4
#: docs/internal-documentation.pod:3212
msgid "Function C<common/utils/utils.c:guestfs_int_fadvise_noreuse>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_fadvise_noreuse>"

#. type: verbatim
#: docs/internal-documentation.pod:3214
#, no-wrap
msgid ""
" void\n"
" guestfs_int_fadvise_noreuse (int fd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_fadvise_noreuse (int fd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3217
msgid "Hint that we will access the data only once."
msgstr "Подсказывает, что мы будем обращаться к данным только один раз."

#. type: textblock
#: docs/internal-documentation.pod:3219
msgid "On Linux, this does nothing."
msgstr "В Linux ничего не делает."

#. type: =head4
#: docs/internal-documentation.pod:3224
msgid "Function C<common/utils/utils.c:guestfs_int_fadvise_dontneed>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_fadvise_dontneed>"

#. type: verbatim
#: docs/internal-documentation.pod:3226
#, no-wrap
msgid ""
" void\n"
" guestfs_int_fadvise_dontneed (int fd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_fadvise_dontneed (int fd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3229
msgid "Hint that we will not access the data in the near future."
msgstr "Подсказывает, что мы не будем обращаться к данным в ближайшем будущем."

#. type: textblock
#: docs/internal-documentation.pod:3231
msgid ""
"On Linux, this immediately writes out any dirty pages in the page cache and "
"then invalidates (drops) all pages associated with this file from the page "
"cache.  Apparently it does this even if the file is opened or being used by "
"other processes.  This setting is not persistent; if you subsequently read "
"the file it will be cached in the page cache as normal."
msgstr ""
"В Linux это немедленно записывает все грязные страницы в кэше страниц, а "
"затем делает недействительными (сбрасывает) все страницы, связанные с этим "
"файлом, из кэша страниц.  По-видимому, это делается даже если файл открыт "
"или используется другими процессами.  Эта настройка не сохраняется; если вы "
"впоследствии прочитаете файл, он будет кэшироваться в кэше страниц как "
"обычно."

#. type: =head4
#: docs/internal-documentation.pod:3241
msgid "Function C<common/utils/utils.c:guestfs_int_fadvise_willneed>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_fadvise_willneed>"

#. type: verbatim
#: docs/internal-documentation.pod:3243
#, no-wrap
msgid ""
" void\n"
" guestfs_int_fadvise_willneed (int fd)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_fadvise_willneed (int fd)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3246
msgid "Hint that we will access the data in the near future."
msgstr "Подсказывает, что мы будем обращаться к данным в ближайшем будущем."

#. type: textblock
#: docs/internal-documentation.pod:3248
msgid ""
"On Linux, this immediately reads the whole file into the page cache.  This "
"setting is not persistent; subsequently pages may be dropped from the page "
"cache as normal."
msgstr ""
"В Linux это немедленно читает весь файл в кэш страниц.  Эта настройка не "
"сохраняется; впоследствии страницы могут быть удалены из кэша страниц как "
"обычно."

#. type: =head4
#: docs/internal-documentation.pod:3255
msgid "Function C<common/utils/utils.c:guestfs_int_shell_unquote>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_shell_unquote>"

#. type: verbatim
#: docs/internal-documentation.pod:3257
#, no-wrap
msgid ""
" char *\n"
" guestfs_int_shell_unquote (const char *str)\n"
"\n"
msgstr ""
" char *\n"
" guestfs_int_shell_unquote (const char *str)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3260
msgid "Unquote a shell-quoted string."
msgstr "Снимает кавычки со строки, экранированной для оболочки."

#. type: textblock
#: docs/internal-documentation.pod:3262
msgid ""
"Augeas passes strings to us which may be quoted, eg. if they come from files "
"in F</etc/sysconfig>.  This function can do simple unquoting of these "
"strings."
msgstr ""
"Augeas передаёт нам строки, которые могут быть заключены в кавычки, "
"например, если они из файлов в F</etc/sysconfig>.  Эта функция может "
"выполнять простое снятие кавычек с этих строк."

#. type: textblock
#: docs/internal-documentation.pod:3266
msgid ""
"Note this function does not do variable substitution, since that is "
"impossible without knowing the file context and indeed the environment under "
"which the shell script is run.  Configuration files should not use complex "
"quoting."
msgstr ""
"Обратите внимание, эта функция не выполняет подстановку переменных, "
"поскольку это невозможно без знания контекста файла и, действительно, среды, "
"в которой выполняется скрипт оболочки.  Файлы конфигурации не должны "
"использовать сложное экранирование."

#. type: textblock
#: docs/internal-documentation.pod:3271
msgid ""
"C<str> is the input string from Augeas, a string that may be single- or "
"double-quoted or may not be quoted.  The returned string is unquoted, and "
"must be freed by the caller.  C<NULL> is returned on error and C<errno> is "
"set accordingly."
msgstr ""
"C<str> — входная строка от Augeas, которая может быть заключена в одинарные "
"или двойные кавычки или не иметь их.  Возвращаемая строка освобождается от "
"кавычек и должна быть освобождена вызывающим.  При ошибке возвращается "
"C<NULL> и соответствующим образом устанавливается C<errno>."

#. type: textblock
#: docs/internal-documentation.pod:3276
msgid ""
"For information on double-quoting in bash, see L<https://www.gnu.org/"
"software/bash/manual/html_node/Double-Quotes.html>"
msgstr ""
"Для получения информации о двойных кавычках в bash см. L<https://www.gnu.org/"
"software/bash/manual/html_node/Double-Quotes.html>"

#. type: =head4
#: docs/internal-documentation.pod:3279
