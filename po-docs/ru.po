" issue_command (const char *cmd, char *argv[], const char *pipecmd,\n"
"                int rc_exit_on_error_flag)\n"
"\n"
msgstr ""
" int\n"
" issue_command (const char *cmd, char *argv[], const char *pipecmd,\n"
"                int rc_exit_on_error_flag)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:4016
msgid "Run a command."
msgstr "Выполняет команду."

#. type: textblock
#: docs/internal-documentation.pod:4018
msgid ""
"C<rc_exit_on_error_flag> is the C<exit_on_error> flag that we pass to the "
"remote server (when issuing I<--remote> commands).  It does not cause "
"C<issue_command> itself to exit on error."
msgstr ""
"C<rc_exit_on_error_flag> — это флаг C<exit_on_error>, который мы передаём "
"удалённому серверу (при отправке команд I<--remote>).  Это не заставляет "
"саму C<issue_command> завершаться при ошибке."

#. type: =head4
#: docs/internal-documentation.pod:4022
msgid "Function C<fish/fish.c:extended_help_message>"
msgstr "Функция C<fish/fish.c:extended_help_message>"

