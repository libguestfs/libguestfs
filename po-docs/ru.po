msgstr ""
" int\n"
" guestfs_int_is_reg (int64_t mode)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3284
msgid ""
"Return true if the C<guestfs_statns> or C<guestfs_lstatns> C<st_mode> field "
"represents a regular file."
msgstr ""
"Возвращает true, если поле C<st_mode> в C<guestfs_statns> или "
"C<guestfs_lstatns> представляет обычный файл."

#. type: =head4
#: docs/internal-documentation.pod:3287
msgid "Function C<common/utils/utils.c:guestfs_int_is_dir>"
msgstr "Функция C<common/utils/utils.c:guestfs_int_is_dir>"

#. type: verbatim
#: docs/internal-documentation.pod:3289
#, no-wrap
msgid ""
" int\n"
" guestfs_int_is_dir (int64_t mode)\n"
"\n"
msgstr ""
" int\n"
" guestfs_int_is_dir (int64_t mode)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:3292
msgid ""
"Return true if the C<guestfs_statns> or C<guestfs_lstatns> C<st_mode> field "
"represents a directory."
msgstr ""
