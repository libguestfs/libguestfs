"  1 = a path element matched, returns C<appliance>,\n"
"  0 = no path element matched,\n"
" -1 = error which aborts the launch process.\n"
"\n"
msgstr ""
"  1 = элемент пути совпал, возвращает C<appliance>,\n"
"  0 = ни один элемент пути не совпал,\n"
" -1 = ошибка, прерывающая процесс запуска.\n"
"\n"

#. type: =head4
