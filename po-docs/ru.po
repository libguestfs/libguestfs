msgid "L<https://issues.redhat.com/browse/RHEL-88508>"
msgstr "L<https://issues.redhat.com/browse/RHEL-88508>"

#. type: textblock
#: docs/guestfs-release-notes-1.56.pod:146
msgid ""
"Run fstrim twice to work around incorrect fstrim behaviour in RHEL 9 kernel"
msgstr ""
"Запускать fstrim дважды для обхода некорректного поведения fstrim в ядре "
"RHEL 9"

#. type: =item
#: docs/guestfs-release-notes-1.56.pod:148
msgid "L<https://issues.redhat.com/browse/RHEL-90168>"
msgstr "L<https://issues.redhat.com/browse/RHEL-90168>"

#. type: textblock
