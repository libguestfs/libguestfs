"\n"
msgstr ""
" int\n"
" guestfs_int_wait4 (guestfs_h *g, pid_t pid, int *status,\n"
"                    struct rusage *rusage, const char *errmsg)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:2139
msgid "A safe version of L<wait4(2)> which retries if C<EINTR> is returned."
msgstr ""
"Безопасная версия L<wait4(2)>, которая повторяет попытку, если возвращён "
"C<EINTR>."

#. type: =head3
#: docs/internal-documentation.pod:2142
msgid "File F<lib/whole-file.c>"
msgstr "Файл F<lib/whole-file.c>"

#. type: =head4
#: docs/internal-documentation.pod:2144
msgid "Function C<lib/whole-file.c:guestfs_int_read_whole_file>"
msgstr "Функция C<lib/whole-file.c:guestfs_int_read_whole_file>"

#. type: verbatim
#: docs/internal-documentation.pod:2146
#, no-wrap
msgid ""
" int\n"
" guestfs_int_read_whole_file (guestfs_h *g, const char *filename,\n"
"                              char **data_r, size_t *size_r)\n"
"\n"
msgstr ""
" int\n"
" guestfs_int_read_whole_file (guestfs_h *g, const char *filename,\n"
"                              char **data_r, size_t *size_r)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:2150 docs/internal-documentation.pod:3376
msgid "Read the whole file C<filename> into a memory buffer."
msgstr "Читает весь файл C<filename> в буфер памяти."

#. type: textblock
#: docs/internal-documentation.pod:2152 docs/internal-documentation.pod:3378
msgid ""
"The memory buffer is initialized and returned in C<data_r>.  The size of the "
"file in bytes is returned in C<size_r>.  The return buffer must be freed by "
"the caller."
msgstr ""
"Буфер памяти инициализируется и возвращается в C<data_r>.  Размер файла в "
"байтах возвращается в C<size_r>.  Возвращённый буфер должен быть освобождён "
"вызывающим."

#. type: textblock
#: docs/internal-documentation.pod:2156
msgid "On error this sets the error in the handle and returns C<-1>."
msgstr "При ошибке устанавливает ошибку в дескрипторе и возвращает C<-1>."

#. type: textblock
#: docs/internal-documentation.pod:2158 docs/internal-documentation.pod:3386
msgid ""
"For the convenience of callers, the returned buffer is NUL-terminated (the "
"NUL is not included in the size)."
msgstr ""
"Для удобства вызывающих возвращённый буфер завершается NUL (NUL не "
"включается в размер)."

#. type: textblock
#: docs/internal-documentation.pod:2161 docs/internal-documentation.pod:3389
msgid ""
"The file must be a B<regular>, B<local>, B<trusted> file.  In particular, do "
"not use this function to read files that might be under control of an "
"untrusted user since that will lead to a denial-of-service attack."
msgstr ""
"Файл должен быть B<обычным>, B<локальным>, B<доверенным> файлом.  В "
"частности, не используйте эту функцию для чтения файлов, которые могут "
"находиться под контролем ненадёжного пользователя, так как это приведёт к "
"атаке типа отказ в обслуживании."

#. type: =head2
#: docs/internal-documentation.pod:2166
msgid "Subdirectory F<common/edit>"
msgstr "Подкаталог F<common/edit>"

#. type: =head3
#: docs/internal-documentation.pod:2168
msgid "File F<common/edit/file-edit.c>"
msgstr "Файл F<common/edit/file-edit.c>"

#. type: textblock
#: docs/internal-documentation.pod:2170
msgid ""
"This file implements common file editing in a range of utilities including "
"L<guestfish(1)>, L<virt-edit(1)>, L<virt-customize(1)> and L<virt-"
"builder(1)>."
msgstr ""
"Этот файл реализует общее редактирование файлов в ряде утилит, включая "
"L<guestfish(1)>, L<virt-edit(1)>, L<virt-customize(1)> и L<virt-builder(1)>."

#. type: textblock
#: docs/internal-documentation.pod:2174
msgid ""
"It contains the code for both interactive-(editor-)based editing and non-"
"interactive editing using Perl snippets."
msgstr ""
"Он содержит код как для интерактивного (на основе редактора), так и для "
"неинтерактивного редактирования с использованием фрагментов Perl."

#. type: =head4
#: docs/internal-documentation.pod:2177
msgid "Function C<common/edit/file-edit.c:edit_file_editor>"
msgstr "Функция C<common/edit/file-edit.c:edit_file_editor>"

#. type: verbatim
#: docs/internal-documentation.pod:2179
#, no-wrap
msgid ""
" int\n"
" edit_file_editor (guestfs_h *g, const char *filename, const char *editor,\n"
"                   const char *backup_extension, int verbose)\n"
"\n"
msgstr ""
" int\n"
" edit_file_editor (guestfs_h *g, const char *filename, const char *editor,\n"
"                   const char *backup_extension, int verbose)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:2183
msgid "Edit C<filename> using the specified C<editor> application."
msgstr ""
"Редактирует C<filename> с использованием указанного приложения C<editor>."

#. type: textblock
#: docs/internal-documentation.pod:2185 docs/internal-documentation.pod:2204
msgid ""
"If C<backup_extension> is not null, then a copy of C<filename> is saved with "
"C<backup_extension> appended to its file name."
msgstr ""
"Если C<backup_extension> не равен null, то копия C<filename> сохраняется с "
"C<backup_extension>, добавленным к имени файла."

#. type: textblock
#: docs/internal-documentation.pod:2188
msgid ""
"If C<editor> is null, then the C<$EDITOR> environment variable will be "
"queried for the editor application, leaving C<vi> as fallback if not set."
msgstr ""
"Если C<editor> равен null, то для приложения редактора будет запрошена "
"переменная окружения C<$EDITOR>, а C<vi> будет использоваться как запасной "
"вариант, если она не установлена."

#. type: textblock
#: docs/internal-documentation.pod:2192
msgid ""
"Returns C<-1> for failure, C<0> on success, C<1> if the editor did not "
"change the file (e.g. the user closed the editor without saving)."
msgstr ""
"Возвращает C<-1> при ошибке, C<0> при успехе, C<1>, если редактор не изменил "
"файл (например, пользователь закрыл редактор без сохранения)."

#. type: =head4
#: docs/internal-documentation.pod:2196
msgid "Function C<common/edit/file-edit.c:edit_file_perl>"
msgstr "Функция C<common/edit/file-edit.c:edit_file_perl>"

#. type: verbatim
#: docs/internal-documentation.pod:2198
