msgstr "Функция C<lib/tmpdirs.c:set_abs_path>"

#. type: verbatim
#: docs/internal-documentation.pod:1824
#, no-wrap
msgid ""
" static int\n"
" set_abs_path (guestfs_h *g, const char *ctxstr,\n"
"               const char *tmpdir, char **tmpdir_ret)\n"
"\n"
msgstr ""
" static int\n"
