#. type: textblock
#: lib/guestfs.pod:3
msgid "guestfs - Library for accessing and modifying virtual machine images"
msgstr "guestfs - bibliotēka virtuālo mašīnu attēlu piekļuvei un mainīšanai"

#. type: verbatim
#: lib/guestfs.pod:9
#, no-wrap
msgid ""
" guestfs_h *g = guestfs_create ();\n"
" guestfs_add_drive (g, \"guest.img\");\n"
" guestfs_launch (g);\n"
" guestfs_mount (g, \"/dev/sda1\", \"/\");\n"
" guestfs_touch (g, \"/hello\");\n"
" guestfs_umount (g, \"/\");\n"
" guestfs_shutdown (g);\n"
" guestfs_close (g);\n"
"\n"
msgstr ""
" guestfs_h *g = guestfs_create ();\n"
" guestfs_add_drive (g, \"guest.img\");\n"
" guestfs_launch (g);\n"
" guestfs_mount (g, \"/dev/sda1\", \"/\");\n"
" guestfs_touch (g, \"/hello\");\n"
" guestfs_umount (g, \"/\");\n"
" guestfs_shutdown (g);\n"
" guestfs_close (g);\n"
"\n"

