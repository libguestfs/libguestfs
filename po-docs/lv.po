#. type: =head1
#: docs/guestfs-release-notes-1.44.pod:5
msgid "RELEASE NOTES FOR LIBGUESTFS 1.44"
msgstr "LIBGUESTFS 1.44 LAIDIENA PIEZĪMES"

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:9
msgid ""
"Python 2 support has been dropped.  The minimum version of Python required "
"is 3.6."
msgstr ""
"Python 2 atbalsts ir atmests.  Minimālā nepieciešamā Python versija ir 3.6."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:12
msgid "Python bindings no longer use deprecated C<PyEval_ThreadsInitialized>."
msgstr ""
"Python saistījumi vairs neizmanto novecojušo C<PyEval_ThreadsInitialized>."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:14
msgid "Python bindings now include type hints (Sam Eiderman)."
msgstr "Python saistījumi tagad ietver tipu mājienus (Sam Eiderman)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:16
msgid "Erlang bindings now use libei instead of liberl_interface (Sergei Golovan)."
msgstr ""
"Erlang saistījumi tagad liberl_interface vietā izmanto libei (Sergei Golovan)"
"."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:21
msgid "L<virt-get-kernel(1)> can now find uncompressed kernels (Pino Toscano)."
msgstr ""
"L<virt-get-kernel(1)> tagad var atrast nesaspiestus kodolus (Pino Toscano)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:24
msgid ""
"L<virt-sysprep(1)> now regenerates the guest certificate store when a "
"certificate is removed from the guest (Pino Toscano)."
msgstr ""
"L<virt-sysprep(1)> tagad atjauno viesa sertifikātu krātuvi, kad no viesa "
"tiek noņemts sertifikāts (Pino Toscano)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:27
msgid ""
"L<virt-sysprep(1)> can now remove IPA enrollment files and Kerberos keytabs "
"(Pino Toscano, Christian Heimes and François Cami)."
msgstr ""
"L<virt-sysprep(1)> tagad var noņemt IPA reģistrācijas failus un Kerberos "
"keytab (Pino Toscano, Christian Heimes un François Cami)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:34
msgid ""
"C<cryptsetup-open> and C<cryptsetup-close> replace C<luks-open>, "
"L<luks-open-ro> and L<luks-close>.  The new APIs add support for BitLocker "
"encryption."
msgstr ""
"C<cryptsetup-open> un C<cryptsetup-close> aizstāj C<luks-open>, L<luks-open-"
"ro> un L<luks-close>.  Jaunās API pievieno BitLocker šifrēšanas atbalstu."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:40
msgid ""
"C<lvm-canonical-lv> no longer produces a noisy error message when called "
"with a non-LV parameter."
msgstr ""
"C<lvm-canonical-lv> vairs nerada skaļu kļūdas ziņojumu, ja to izsauc ar "
"parametru, kas nav LV."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:45
msgid "C programs using libguestfs can now be compiled against the build directory:"
msgstr ""
"C programmas, kas izmanto libguestfs, tagad var kompilēt pret būvēšanas "
"direktoriju:"

#. type: verbatim
#: docs/guestfs-release-notes-1.44.pod:48
#, no-wrap
msgid ""
" ../libguestfs/run ./configure\n"
" ../libguestfs/run make\n"
"\n"
msgstr ""
" ../libguestfs/run ./configure\n"
" ../libguestfs/run make\n"
"\n"

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:51
msgid ""
"OCaml components are now linked correctly when building in a different "
"directory from the source (Geoff Toole)."
msgstr ""
"OCaml komponenti tagad tiek pareizi saistīti, būvējot citā direktorijā nekā "
"pirmkods (Geoff Toole)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:54
msgid "GCC LTO is now supported."
msgstr "Tagad tiek atbalstīts GCC LTO."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:56
msgid "Weblate is now used for localization instead of Zanata (Pino Toscano)."
msgstr "Lokalizācijai tagad Zanata vietā tiek izmantots Weblate (Pino Toscano)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:59
msgid ""
"The dependencies for guestfsd are no longer hard-coded but are now generated "
"from the built binary, ensuring that they shouldn't get out of synch in "
"future (Hilko Bengen)."
msgstr ""
"Guestfsd atkarības vairs nav iekodētas, bet tagad tiek ģenerētas no uzbūvētā "
"binārā faila, nodrošinot, ka nākotnē tās nevajadzētu nonākt nesinhronā "
"stāvoklī (Hilko Bengen)."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:65
msgid ""
"F<lib/guestfs.h> was moved to F<include/guestfs.h> in the source.  This is "
"not an externally visible change but affected a lot of places inside the "
"build system."
msgstr ""
"F<lib/guestfs.h> pirmkodā tika pārvietots uz F<include/guestfs.h>.  Tās nav "
"ārēji redzamas izmaiņas, taču tās ietekmēja daudzas vietas būvēšanas sistēmā."

#. type: textblock
#: docs/guestfs-release-notes-1.44.pod:73
msgid "https_proxy= ./bugs-in-changelog.sh v1.42.0.."
msgstr "https_proxy= ./bugs-in-changelog.sh v1.42.0.."

