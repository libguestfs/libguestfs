" void\n"
" guestfs_int_launch_timeout (guestfs_h *g)\n"
"\n"
msgstr ""
" void\n"
" guestfs_int_launch_timeout (guestfs_h *g)\n"
"\n"

#. type: textblock
#: docs/internal-documentation.pod:851
msgid "Raise an error if the appliance hangs during launch."
msgstr "Izraisīt kļūdu, ja palīgsistēma palaišanas laikā uzkaras."

#. type: =head4
#: docs/internal-documentation.pod:853
msgid "Function C<lib/errors.c:guestfs_int_external_command_failed>"
msgstr "Funkcija C<lib/errors.c:guestfs_int_external_command_failed>"

#. type: verbatim
#: docs/internal-documentation.pod:855
#, no-wrap
msgid ""
