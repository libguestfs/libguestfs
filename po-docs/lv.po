#. type: textblock
#: lib/guestfs-actions.pod:3379
msgid ""
"C<guestfs_copy_in> copies local files or directories recursively into the "
"disk image, placing them in the directory called C<remotedir> (which must "
"exist)."
msgstr ""
"C<guestfs_copy_in> rekursīvi iekopē lokālos failus vai direktorijas diska "
"attēlā, ievietojot tos direktorijā C<remotedir> (kam jāeksistē)."

#. type: textblock
#: lib/guestfs-actions.pod:3387 lib/guestfs-actions.pod:3408
msgid "(Added in 1.29.24)"
msgstr "(Pievienots versijā 1.29.24)"

