" $ guestfish -a /dev/null run -v |& ts -i '%.s'\n"
" 0.000022 libguestfs: launch: program=guestfish\n"
" 0.000134 libguestfs: launch: "
"version=1.29.31fedora=23,release=2.fc23,libvirt\n"
