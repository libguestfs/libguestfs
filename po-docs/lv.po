#. type: textblock
#: docs/internal-documentation.pod:268
msgid "Build supermin appliance from C<supermin_path> to F<$TMPDIR/.guestfs-$UID>."
msgstr ""
"Uzbūvēt supermin palīgsistēmu no C<supermin_path> uz F<$TMPDIR/.guestfs-$UID>"
"."

#. type: textblock
#: docs/internal-documentation.pod:271
msgid "Returns: C<0> = built or C<-1> = error (aborts launch)."
msgstr "Atgriež: C<0> = uzbūvēts vai C<-1> = kļūda (pārtrauc palaišanu)."

#. type: =head4
#: docs/internal-documentation.pod:273
msgid "Function C<lib/appliance.c:run_supermin_build>"
msgstr "Funkcija C<lib/appliance.c:run_supermin_build>"

#. type: verbatim
