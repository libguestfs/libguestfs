#. type: =head1
#: docs/guestfs-recipes.pod:477
msgid "Hex-dumping sectors from the guest"
msgstr "Sektoru heksadecimālā izmešana no viesa"

#. type: textblock
#: docs/guestfs-recipes.pod:479
msgid "Hex-dump the boot partition (Master Boot Record / first sector):"
msgstr ""
"Heksadecimāli izmest sāknēšanas nodalījumu (Master Boot Record / pirmo "
"sektoru):"

#. type: verbatim
#: docs/guestfs-recipes.pod:481
#, no-wrap
msgid ""
" guestfish --ro -a disk.img run : pread-device /dev/sda 0x200 0 |\n"
"   hexdump -C\n"
"\n"
msgstr ""
" guestfish --ro -a disk.img run : pread-device /dev/sda 0x200 0 |\n"
"   hexdump -C\n"
"\n"

#. type: textblock
#: docs/guestfs-recipes.pod:484
msgid "(C<0x200> = 512 bytes which is the size of traditional PC sectors)"
msgstr "(C<0x200> = 512 baiti, kas ir tradicionālo PC sektoru izmērs)"

#. type: textblock
#: docs/guestfs-recipes.pod:486
msgid ""
"To hexdump the N'th partition, substitute a number for C<N> in the following "
"command:"
msgstr ""
"Lai heksadecimāli izmestu N-to nodalījumu, šajā komandā aizstājiet C<N> ar "
"skaitli:"

#. type: verbatim
#: docs/guestfs-recipes.pod:489
#, no-wrap
msgid ""
" guestfish --ro -a disk.img \\\n"
"     run : pread-device /dev/sda 0x200 $((N*0x200)) |\n"
"   hexdump -C\n"
"\n"
msgstr ""
" guestfish --ro -a disk.img \\\n"
"     run : pread-device /dev/sda 0x200 $((N*0x200)) |\n"
"   hexdump -C\n"
"\n"

#. type: =head1
