#: docs/guestfs-hacking.pod:58
msgid "F<appliance>"
msgstr "F<appliance>"

#. type: textblock
#: docs/guestfs-hacking.pod:60
msgid "The libguestfs appliance, build scripts and so on."
msgstr "Libguestfs palīgsistēma, būvēšanas skripti u. tml."

#. type: =item
#: docs/guestfs-hacking.pod:62
msgid "F<bash>"
msgstr "F<bash>"

#. type: textblock
#: docs/guestfs-hacking.pod:64
msgid "Bash tab-completion scripts."
msgstr "Bash tabulēšanas pabeigšanas skripti."

#. type: =item
#: docs/guestfs-hacking.pod:66
msgid "F<build-aux>"
msgstr "F<build-aux>"

#. type: textblock
#: docs/guestfs-hacking.pod:68
msgid "Various build scripts used by autotools."
msgstr "Dažādi autotools izmantoti būvēšanas skripti."

#. type: =item
#: docs/guestfs-hacking.pod:70
msgid "F<builder>"
msgstr "F<builder>"

#. type: textblock
#: docs/guestfs-hacking.pod:72
msgid "L<virt-builder(1)> command and documentation."
msgstr "Komanda L<virt-builder(1)> un dokumentācija."

#. type: =item
#: docs/guestfs-hacking.pod:74
msgid "F<cat>"
msgstr "F<cat>"

#. type: textblock
#: docs/guestfs-hacking.pod:76
msgid ""
"The L<virt-cat(1)>, L<virt-filesystems(1)>, L<virt-log(1)>, L<virt-ls(1)> "
"and L<virt-tail(1)> commands and documentation."
msgstr ""
"Komandas L<virt-cat(1)>, L<virt-filesystems(1)>, L<virt-log(1)>, L<virt-ls"
"(1)> un L<virt-tail(1)> un dokumentācija."

#. type: =item
#: docs/guestfs-hacking.pod:79
msgid "F<common>"
msgstr "F<common>"

#. type: textblock
#: docs/guestfs-hacking.pod:81
msgid ""
"Various libraries of internal code can be found in the F<common> "
"subdirectory:"
msgstr "Dažādas iekšējā koda bibliotēkas atrodamas apakšdirektorijā F<common>:"

#. type: =item
#: docs/guestfs-hacking.pod:86
msgid "F<common/edit>"
msgstr "F<common/edit>"

#. type: textblock
#: docs/guestfs-hacking.pod:88
msgid ""
"Common code for interactively and non-interactively editing files within a "
"libguestfs filesystem."
msgstr ""
"Kopīgs kods failu interaktīvai un neinteraktīvai rediģēšanai libguestfs "
"failu sistēmā."

#. type: =item
#: docs/guestfs-hacking.pod:91
msgid "F<common/errnostring>"
msgstr "F<common/errnostring>"

#. type: textblock
#: docs/guestfs-hacking.pod:93
msgid ""
"The communication protocol used between the library and the daemon running "
"inside the appliance has to encode errnos as strings, which is handled by "
"this library."
msgstr ""
