"L<libguestfs-test-tool(1)>, L<libguestfs-make-fixed-appliance(1)>."

#. type: textblock
#: lib/guestfs.pod:3274
msgid ""
"Related manual pages: L<supermin(1)>, L<qemu(1)>, L<hivex(3)>, L<stap(1)>, "
