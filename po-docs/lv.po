msgstr "Fails F<fish/fish.c>"

#. type: textblock
#: docs/internal-documentation.pod:3961
msgid ""
"guestfish, the guest filesystem shell.  This file contains the main loop and "
"utilities."
msgstr ""
"guestfish, viesa failu sistēmas čaula.  Šis fails satur galveno ciklu un "
"utilītas."

#. type: =head4
#: docs/internal-documentation.pod:3964
msgid "Function C<fish/fish.c:parse_command_line>"
msgstr "Funkcija C<fish/fish.c:parse_command_line>"

#. type: verbatim
#: docs/internal-documentation.pod:3966
#, no-wrap
